# Application Name (configurable branding)
NEXT_PUBLIC_APP_NAME=Adoptanet

# Backend REST API base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google OAuth Client ID (optional, for client-side login redirect)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Post-Adoption Follow-Up & Return Demo Toolbar (US-20 / US-21)
# Displays the interactive fast-forward / time-travel toolbar on /follow-up
NEXT_PUBLIC_FOLLOW_UP_DEMO_MODE=true

